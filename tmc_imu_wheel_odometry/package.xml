<package format="3">
  <name>tmc_imu_wheel_odometry</name>
  <version>3.0.0</version>
  <description>IMU and wheel odometry fusion package</description>
  <author email="nobuyuki_matsuno@mail.toyota.co.jp">Nobuyuki Matsuno</author>
  <maintainer email="xr-hsr-support@mail.toyota.co.jp">HSR Support</maintainer>

  <license>BSD 3-clause Clear License</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>tmc_navigation_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>tf_transformations</exec_depend>
